# systemd EnvironmentFile syntax: no shell expansion and no 'export'.
STT_SERVICE=vosk
STT_LANGUAGE=en-US
DEBUG_LOGGING=false
USE_INBUILT_BLE=false
WEBSERVER_PORT=8080
# Set one independent 32+-character token per enrolled ESN before enabling the
# Hermes bridge. The bridge stays disabled while this JSON map is blank.
# WIREPOD_HERMES_BRIDGE_TOKENS={"ESN_A":"random-token-a","ESN_B":"random-token-b"}
WIREPOD_HERMES_BRIDGE_TOKENS=
